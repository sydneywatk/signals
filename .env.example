# State Affairs signals pipeline — environment variables
# Copy to .env and fill real values for live-mode runs.
# Fixture-mode runs (USE_LIVE_APIS=false) work with all of these unset.

# ---- Source APIs ----
OPENSTATES_API_KEY=
LDA_API_KEY=
LDA_BASE_URL=https://lda.senate.gov/api/v1
EDGAR_USER_AGENT=Your Name Project your.email@example.com
ANTHROPIC_API_KEY=

# ---- Distribution ----
# Slack incoming webhook. If unset, alerts print to stdout (dry-run).
SLACK_WEBHOOK_URL=

# ---- Pipeline mode ----
# false = fixtures only, no external calls (default for development)
# true  = live APIs (CI cron, capture_fixtures.py, final demo)
USE_LIVE_APIS=false

# ---- Modal /trigger endpoint ----
# Shared secret required in X-Trigger-Secret header for /trigger POST
TRIGGER_SECRET=
